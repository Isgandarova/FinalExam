@model OurPortifolio
<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Create form</h4>
           <div class="text-danger" asp-validation-summary="All"></div>
            <form class="forms-sample" method="post">
                <div class="form-group">
                    <label for="exampleInputUsername1">Image Url</label>
                    <input type="text" class="form-control" id="exampleInputUsername1" placeholder="ImageUrl" asp-for="ImageUrl">
                </div>
                <div class="form-group">
                    <label for="exampleInputUsername1">Title</label>
                    <input type="text" class="form-control" id="exampleInputUsername1" placeholder="Title" asp-for="Title">
                </div>
                <div class="form-group">
                    <label for="exampleInputUsername1">Category</label>
                    <input type="text" class="form-control" id="exampleInputUsername1" placeholder="Category" asp-for="Category">
                </div>
             
                <button type="submit" class="btn btn-primary mr-2" asp-action="create" asp-controller="ourportifolio">Create</button>
                <button class="btn btn-light" asp-action="index" asp-controller="OurPortifolio">Cancel</button>
            </form>
        </div>
    </div>
</div>